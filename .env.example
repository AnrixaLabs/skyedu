# ----------------------
# WordPress publishing
# ----------------------
# Base site URL (root, not /wp-json):
WP_BASE_URL=https://skyed.org
# Alternative (supported): WP_BASE=https://skyed.org
# Fail-closed publishing target; staging requires deliberate change.
SKYED_EXPECTED_WP_HOST=skyed.org

WP_USER=your_wp_username
WP_APP_PASSWORD=your_wp_app_password
# page | post
WP_POST_TYPE=page
# For staging: draft. Production default: publish.
WP_PUBLISH_STATUS=publish

# WP rendering: shortcode (recommended) | raw_html (legacy)
WP_RENDER_MODE=shortcode

# ----------------------
# Quiz hosting
# ----------------------
# This MUST point to a REAL static host that serves:
#   {QUIZ_PUBLIC_BASE}/{slug}/index.html
# and the folder contains index.html + quiz.json
#
# Leave blank to use the built-in in-page practice.
# Set only if a real independent static host was tested.
QUIZ_PUBLIC_BASE=
TAGS_PUBLIC_BASE=

# embed | link | off
# embed: show Start Quiz button + iframe
# link : show Start Quiz button only
# off  : no quiz section
QUIZ_EMBED_MODE=embed

# ----------------------
# Output paths
# ----------------------
OUTPUT_DIR=output
# Recommended font shipped with this repo:
#   assets/fonts/NotoSansCJKsc-VF.ttf
# (Variable font; works with Pillow on Windows/Linux.)
FONT_PATH=assets/fonts/NotoSansCJKsc-VF.ttf

# ----------------------
# Image backend selection
# ----------------------
# local_assets_only | comfyui | cloudflare_flux | hf_endpoint | noop
IMG_BACKEND=local_assets_only
# Use the existing SkyED asset database; do not regenerate images before Sunny QLoRA.
# If running from a separate checkout, point to the original assets directory:
# SKYED_LOCAL_ASSET_LIBRARY_DIR=C:\Users\user\PycharmProjects\skyed_automation\asset_library
# Existing asset images are allowed provisionally for guided practice.
# Set 1 only when requiring a separately teacher-reviewed label-free assessment:
# SKYED_REQUIRE_LABEL_FREE_REVIEW=1
PICTURE_CARDS_TYPE=Realistic

IMG_WIDTH=768
IMG_HEIGHT=768
IMG_STEPS=1
IMG_TIMEOUT_S=180
IMG_CONCURRENCY=1
IMG_MAX_RETRIES=2
SKYED_CF_SMART_LOCAL=0

# --- ComfyUI backend ---
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=assets/comfy/workflow_api.json

# --- Cloudflare Workers AI (Flux) ---
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Hugging Face dedicated endpoint ---
HF_IMAGE_ENDPOINT_URL=
HF_TOKEN=
HF_GUIDANCE=6

# ----------------------
# TTS
# ----------------------
SKYED_TTS_RATE=-10%
SKYED_VOICE_EN=en-US-JennyNeural
SKYED_VOICE_ZH=zh-CN-XiaoxiaoNeural

# ----------------------
# Picture Reader OCR
# ----------------------
SKYED_OCR_BACKEND=auto
SKYED_OCR_DEVICE=cuda

# ----------------------
# Special lesson extra audio
# ----------------------
SKYED_SPECIAL_AUDIO_ENABLED=0
SKYED_SPECIAL_AUDIO_DIR=
SKYED_SPECIAL_AUDIO_TITLE=Extra Audio
